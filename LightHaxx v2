createButton("Anti Afk/Kick ", function()
	do
    local vu = game:GetService('VirtualUser')
    LocalPlayer.Idled:Connect(function()
        if settings.antiAFK then
            vu:CaptureController()
            vu:ClickButton2(Vector2.new())
        end
    end)

    -- Anti Kick attempts to neutralize common kick calls
    local success, mt = pcall(function() return getrawmetatable(game) end)
    if success and mt then
        local old = mt.__namecall
        local protect = newcclosure or protect_function or function(f) return f end
        setreadonly(mt, false)
        mt.__namecall = protect(function(self, ...)
            local method = getnamecallmethod()
            if method == "Kick" then
                -- ignore kicks by blocking
                return
            end
            return old(self, ...)
        end)
        pcall(function()
            hookfunction(game.Players.LocalPlayer.Kick, protect(function() end))
        end)
    end
end
end)

-- Minimize / Expand behavior
local minimized = false
local originalSize = frame.Size

minimizeButton.MouseButton1Click:Connect(function()
	minimized = not minimized
	if minimized then
		frame:TweenSize(UDim2.new(0, 320, 0, 40), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
		subtitle.Visible = false
		scrollFrame.Visible = false
		minimizeButton.Text = "+"
	else
		frame:TweenSize(originalSize, Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
		task.wait(0.3)
		subtitle.Visible = true
		scrollFrame.Visible = true
		minimizeButton.Text = "-"
	end
end)
