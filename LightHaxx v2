createButton("Auto Equip ", function()
	while true do
	-- Get player and services fresh each time
	local Players = game:GetService("Players")
	local player = Players.LocalPlayer
	local backpack = player:WaitForChild("Backpack")

	-- Function to get the tool with the highest add value
	local function getHighestAddTool(character)
		local bestTool = nil
		local highestValue = -math.huge

		-- Check tools in backpack
		for _, tool in ipairs(backpack:GetChildren()) do
			if tool:IsA("Tool") then
				local add = tool:FindFirstChild("add")
				if add and add:IsA("IntValue") and add.Value > highestValue then
					highestValue = add.Value
					bestTool = tool
				end
			end
		end

		-- Also check equipped tools
		for _, tool in ipairs(character:GetChildren()) do
			if tool:IsA("Tool") then
				local add = tool:FindFirstChild("add")
				if add and add:IsA("IntValue") and add.Value > highestValue then
					highestValue = add.Value
					bestTool = tool
				end
			end
		end

		return bestTool
	end

	-- Function to equip the best tool
	local function equipBestTool()
		local character = player.Character
		if not character then return end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then return end

		local bestTool = getHighestAddTool(character)
		if bestTool then
			local equippedTool = nil
			for _, tool in ipairs(character:GetChildren()) do
				if tool:IsA("Tool") then
					equippedTool = tool
					break
				end
			end

			-- Equip best tool if not already equipped
			if equippedTool ~= bestTool then
				pcall(function()
					humanoid:UnequipTools()
					task.wait(0.05)
					humanoid:EquipTool(bestTool)
				end)
			end
		end
	end

	-- Main execution for current character
	local character = player.Character or player.CharacterAdded:Wait()
	character:WaitForChild("Humanoid")

	-- Keep equipping best tool while alive
	while character and character.Parent do
		equipBestTool()
		task.wait(0.1)
	end

	-- Wait 5 seconds, then rerun everything from the top as fresh
	task.wait(5)
end
end)

